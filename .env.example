# Copy to .env.local. Never commit credentials.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_AUTH_MODE=auto
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional for a local semantic scoring pass; the agent and exact scorer do not use it.
OPENAI_API_KEY=
REPRISE_POLICY=guarded
REPRISE_SETTLE_MS=1000
REPRISE_WRITE_SETTLE_MS=900
REPRISE_LATENCY_PROFILE=instant
REPRISE_MODE=productivity

# Real Google Workspace integration. Enable Calendar, Tasks and Gmail APIs.
# Create a Web application OAuth client; these are separate from GOOGLE_API_KEY.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8844/google/callback
# Optional path to the private OAuth token file (default: .google-workspace-token.json).
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASK_LIST_ID=@default
# Blank creates a Reprise Shopping task list on the first eligible shopping request.
GOOGLE_SHOPPING_LIST_ID=
REPRISE_TIME_ZONE=Asia/Kolkata

# Optional experimental local text planner; Gemini Live remains the default.
REPRISE_LOCAL_URL=http://127.0.0.1:8081
REPRISE_LOCAL_MODEL=reprise-gemma-e2b
# Optional compact prompt is experimental; legacy remains the default.
REPRISE_LOCAL_PROMPT_PROFILE=legacy

# Live Call Assist: isolated Calendar mock by default; no Google credentials used.
REPRISE_CALL_ASSIST_BACKEND=mock
# To opt into real Calendar, set backend=google AND this flag=1 explicitly.
REPRISE_CALL_ASSIST_GOOGLE_WRITES=0
