# Copy to .env.local. Never commit credentials.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_AUTH_MODE=auto
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional for a local semantic scoring pass; the agent and exact scorer do not use it.
OPENAI_API_KEY=
REPRISE_POLICY=guarded
REPRISE_SETTLE_MS=1000
REPRISE_WRITE_SETTLE_MS=900
REPRISE_LATENCY_PROFILE=instant
REPRISE_MODE=benchmark
